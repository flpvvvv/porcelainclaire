NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
REVALIDATION_SECRET=your-revalidation-secret

# Optional: used by `sync/` CLI (`uv run sync article`, `backfill-tags`) for Gemini auto-tagging.
# Not read by the Next.js app. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Server-only: used by `sync/` and by /api/read + /bot-trap.
# Never expose the service key to the browser (do not prefix with NEXT_PUBLIC_).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional: salt for hashing IPs in reading/bot-trap logs.
# Falls back to REVALIDATION_SECRET when unset.
ANALYTICS_SALT=your-random-salt
